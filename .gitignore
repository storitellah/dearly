coverage/
.eslintcache
*.tsbuildinfo

# Cloudflare / Wrangler local state
.wrangler/
.dev.vars

# User content must never be committed: letters, archives, exports, keys
*.dearly
*.dearly.json
exports/
letters/
private/
*.pem
*.key
*.p12
*.pfx
