# Cloudflare Pages redirects.
#
# Dearly routes with the URL hash (#/library, #/write/<id>), so the application
# itself needs no server-side rewriting at all. The final rule exists only so a
# hand-typed or bookmarked path lands on the app instead of a bare 404.
#
# The self-rewrites above it are deliberate belt and braces. A catch-all that
# shadowed a real asset would serve index.html in place of the JavaScript and
# CSS bundles, and the app would never start — so every directory holding real
# files is mapped to itself first, and cannot be swallowed by the catch-all
# regardless of how rule precedence is evaluated.

/assets/*       /assets/:splat        200
/icons/*        /icons/:splat         200
/stationery/*   /stationery/:splat    200
/textures/*     /textures/:splat      200
/sounds/*       /sounds/:splat        200
/fonts/*        /fonts/:splat         200
/print/*        /print/:splat         200
/sw.js          /sw.js                200
/boot.css       /boot.css             200
/offline.css    /offline.css          200
/offline.html   /offline.html         200
/manifest.webmanifest  /manifest.webmanifest  200
/robots.txt     /robots.txt           200

# Optional Pages Functions must reach their handlers, never the app shell.
/api/*          /api/:splat           200

# Last resort only.
/*              /index.html           200
