# ---------------------------------------------------------------------------
# Dearly — example environment file
#
# Copy to `.env` for local development:  cp .env.example .env
# Nothing in this file is required: with an empty environment Dearly builds and
# runs with every core feature (writing, saving, printing, export, backup,
# encryption, offline) fully working.
#
# Values prefixed with VITE_ are inlined into the client bundle at build time
# and are therefore PUBLIC. Never put a secret behind a VITE_ prefix.
# ---------------------------------------------------------------------------

# Public site URL, used only to build canonical/social-preview URLs.
# Leave blank to derive it from the browser's own location, which is what you
# want on pages.dev preview deployments.
VITE_SITE_URL=

# Base path the app is served from. Keep "/" for a root domain, a subdomain or
# a pages.dev address. Set e.g. "/dearly/" only when hosting in a subdirectory.
VITE_BASE_PATH=/

# Deployment label shown in Settings → About and in the preview banner.
# Cloudflare Pages sets CF_PAGES_BRANCH automatically; this is for local use.
VITE_DEPLOY_ENV=development

# Optional: enable the private feedback form, which posts to the Pages Function
# at /api/feedback. Leave "false" and the form is hidden; the rest of the app is
# unaffected.
VITE_ENABLE_FEEDBACK=false

# Optional: enable the AI writing assistant, which posts to /api/assist.
# Disabled by default and never enabled implicitly. No letter text is ever sent
# without an explicit, per-request confirmation from the user.
VITE_ENABLE_AI_ASSIST=false

# ---------------------------------------------------------------------------
# Server-side only — set these in the Cloudflare Pages dashboard as encrypted
# secrets (Settings → Environment variables). They are read exclusively by the
# Pages Functions in /functions and are never exposed to the browser.
# Do NOT add them to this file with real values, and do NOT commit a .env.
# ---------------------------------------------------------------------------

# FEEDBACK_WEBHOOK_URL=
# AI_API_KEY=
# AI_API_URL=
# AI_MODEL=
